[Unit]
Description=Fcitx5 Input Method Framework
PartOf=graphical-session.target
After=graphical-session.target gnome-session-initialized.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionUser=!@system

[Service]
Type=simple
ExecStartPre=/usr/bin/fcitx5-prestart-setup
ExecStart=/usr/bin/fcitx5 --replace
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target gnome-session.target
