[Unit]
Description=One-time Setup Tailscale Operator for Desktop User
Documentation=https://tailscale.com/docs/reference/troubleshooting/linux/linux-operator-permission
ConditionPathExists=!/var/lib/tailscale/.operator-configured
After=tailscaled.service graphical.target
Wants=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/my-bluefin/tailscale-operator-setup

[Install]
WantedBy=graphical.target
