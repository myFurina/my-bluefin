[Unit]
Description=Configure System Flatpak USTC Mirror
Before=system-flatpak-setup.service
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'if ! grep -q "dl.flathub.org" /etc/hosts 2>/dev/null; then printf "\n# Flathub CDN Anycast\n151.101.2.217 dl.flathub.org\n151.101.66.217 dl.flathub.org\n151.101.130.217 dl.flathub.org\n151.101.194.217 dl.flathub.org\n" >> /etc/hosts; fi; /usr/bin/flatpak remote-modify --system flathub --url=https://mirrors.ustc.edu.cn/flathub 2>/dev/null || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
