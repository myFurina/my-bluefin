[Unit]
Description=Optimize Flathub CDN IP and Mirror
Before=system-flatpak-setup.service flatpak-preinstall.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/optimize-flathub
RemainAfterExit=yes
TimeoutSec=45

[Install]
WantedBy=multi-user.target
