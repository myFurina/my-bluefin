KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="backlight", RUN+="/usr/bin/chmod -f 666 /sys/class/backlight/%k/brightness /sys/class/backlight/%k/bl_power /sys/module/video/parameters/brightness_switch_enabled"
ACTION=="add", SUBSYSTEM=="module", KERNEL=="video", RUN+="/usr/bin/chmod -f 666 /sys/module/video/parameters/brightness_switch_enabled"
