#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
只为两件事服务：
  1. AppStream 的图标/截图是 https://dl.flathub.org/media/... 的绝对地址，
     镜像不提供 /media/，所以给 dl.flathub.org 选最稳的 Fastly 节点写进 hosts；
  2. 确保 flathub 源走 USTC 镜像（应用本体/元数据从镜像拉，快 100 倍）。

选路用 3 次采样按成功率排序：通过国内 DoH 实时查询最新官方 IP，
并与亚太候选池合并，3 次采样至少成功 2 次才采纳，杜绝死 IP。
"""

from __future__ import annotations

import concurrent.futures
import fcntl
import json
import os
import re
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
import urllib.request

HOSTS_FILE = "/etc/hosts"
HOSTS_BACKUP = "/etc/hosts.optimize-network.bak"
LOCK_FILE = "/etc/.optimize-network.lock"
FLATPAK = "/usr/bin/flatpak"
RESTORECON = "/usr/sbin/restorecon"

DOMAIN = "dl.flathub.org"
OFFICIAL_REPO_URL = "https://dl.flathub.org/repo/"
MIRROR_CONTENT_URL = "https://mirrors.ustc.edu.cn/flathub"
CANDIDATES = [
    "151.101.1.91", "151.101.65.91", "151.101.129.91",
    "151.101.193.91", "146.75.113.91", "199.232.161.91",
]
PROBE_PATH = "/repo/summary"       # 支持 Range，可稳定取到 256KB
CAP = 262144
DEADLINE = 6.0
ATTEMPTS = 3
MIN_SUCCESS = 2                    # 3 次里至少成功 2 次才采用


def log(msg):
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def fetch_doh_ips(timeout=2.5):
    """通过国内高可用 DoH 实时解析官方最新 A 记录，保证候选 IP 永远不脱节"""
    urls = (
        f"https://dns.alidns.com/resolve?name={DOMAIN}&type=A",
        f"https://doh.pub/dns-query?name={DOMAIN}&type=A",
    )
    ips = []
    for url in urls:
        try:
            req = urllib.request.Request(
                url,
                headers={"User-Agent": "curl/8.0", "Accept": "application/dns-json"},
            )
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8", "replace"))
            for ans in data.get("Answer", ()):
                ip = str(ans.get("data", "")).strip()
                if ans.get("type") == 1 and re.fullmatch(r"\d{1,3}(?:\.\d{1,3}){3}", ip):
                    ips.append(ip)
        except Exception:
            continue
    return list(dict.fromkeys(ips))


def probe_once(ip):
    """返回 (成功?, 毫秒, 收到字节)"""
    start = time.time()
    ctx = ssl.create_default_context()
    try:
        sock = socket.create_connection((ip, 443), timeout=3.0)
        ssock = ctx.wrap_socket(sock, server_hostname=DOMAIN)
    except Exception:
        return False, None, 0
    try:
        req = (
            f"GET {PROBE_PATH} HTTP/1.1\r\nHost: {DOMAIN}\r\n"
            f"User-Agent: optimize-flathub/3\r\nAccept: */*\r\n"
            f"Range: bytes=0-{CAP - 1}\r\nConnection: close\r\n\r\n"
        )
        ssock.settimeout(3.0)
        data_start = time.time()
        ssock.sendall(req.encode("ascii"))
        received = 0
        while received < CAP:
            if time.time() - data_start > DEADLINE:
                break
            try:
                chunk = ssock.recv(16384)
            except (socket.timeout, ssl.SSLError):
                break
            if not chunk:
                break
            received += len(chunk)
        elapsed_ms = int((time.time() - data_start) * 1000)
        return received >= CAP * 0.85, elapsed_ms, received
    except Exception:
        return False, None, 0
    finally:
        try:
            ssock.close()
        except OSError:
            pass


def pick_node():
    doh_ips = fetch_doh_ips()
    all_candidates = list(dict.fromkeys(doh_ips + CANDIDATES))
    if doh_ips:
        log(f"==> 动态 DoH 发现官方最新活跃 IP: {', '.join(doh_ips)}")

    def score(ip):
        results = [probe_once(ip) for _ in range(ATTEMPTS)]
        ok = sum(1 for r in results if r[0])
        times = sorted(r[1] for r in results if r[0] and r[1] is not None)
        median = times[len(times) // 2] if times else None
        return ip, ok, median

    best = None
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(all_candidates)) as pool:
        for ip, ok, median in pool.map(score, all_candidates):
            log(f"    {ip:<16} 成功 {ok}/{ATTEMPTS}"
                + (f"  中位 {median}ms" if median else "  全部卡死"))
            if ok < MIN_SUCCESS:
                continue
            key = (ok, -(median or 10 ** 9))
            if best is None or key > best[0]:
                best = (key, ip)
    return best[1] if best else None


def is_managed_line(line):
    if "Dynamic Optimized IP" in line:
        return True
    fields = line.split("#", 1)[0].split()
    return len(fields) >= 2 and DOMAIN in fields[1:]


def build_hosts(lines, ip):
    kept = [l for l in lines if not is_managed_line(l)]
    while kept and not kept[-1].strip():
        kept.pop()
    if kept and not kept[-1].endswith("\n"):
        kept[-1] += "\n"
    if ip:
        kept.append(f"\n{ip:<16} {DOMAIN} # Dynamic Optimized IP (appstream media)\n")
    return "".join(kept)


def atomic_write(path, text):
    directory = os.path.dirname(path) or "/"
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".hosts-", suffix=".tmp")
    os.close(fd)
    try:
        if os.path.exists(path):
            shutil.copy2(path, tmp)          # 保留 mode/owner/security.selinux
        with open(tmp, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
        dir_fd = os.open(directory, os.O_DIRECTORY)
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
        if os.path.exists(RESTORECON):
            subprocess.run([RESTORECON, "-F", path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def update_hosts(ip, dry_run):
    if dry_run:
        with open(HOSTS_FILE, encoding="utf-8", errors="surrogateescape") as f:
            lines = f.readlines()
        new_text = build_hosts(lines, ip)
        if new_text == "".join(lines):
            log("==> /etc/hosts 无需改动")
            return
        log("==> [dry-run] 将写入：")
        print(new_text)
        return

    if os.geteuid() != 0:
        log("==> 非 root，跳过写入 /etc/hosts")
        return

    lock = open(LOCK_FILE, "a")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open(HOSTS_FILE, encoding="utf-8", errors="surrogateescape") as f:
            lines = f.readlines()
        new_text = build_hosts(lines, ip)
        if new_text == "".join(lines):
            log("==> /etc/hosts 无需改动")
            return
        shutil.copy2(HOSTS_FILE, HOSTS_BACKUP)
        atomic_write(HOSTS_FILE, new_text)
        log(f"==> 已写入 {HOSTS_FILE}（备份 {HOSTS_BACKUP}）")
    finally:
        fcntl.flock(lock, fcntl.LOCK_UN)
        lock.close()


def configure_flatpak(dry_run):
    if dry_run:
        log(f"[dry-run] 将配置 flathub 主地址为官方源 {OFFICIAL_REPO_URL} (AppStream/元数据走已优化的 Fastly 节点)")
        log(f"[dry-run] 将配置 flathub contenturl 为镜像源 {MIRROR_CONTENT_URL} (大包走中科大高速拉取)")
        return

    # 1. 确保 flathub 主 URL 始终为官方源 (确保 AppStream 元数据、更新摘要 100% 完整可用)
    m = subprocess.run([FLATPAK, "remote-modify", "--system", "flathub",
                        f"--url={OFFICIAL_REPO_URL}"], capture_output=True, text=True)
    if m.returncode == 0:
        log(f"flathub 主源已配置: {OFFICIAL_REPO_URL} (AppStream 元数据直连)")
    else:
        log(f"配置主源失败: {m.stderr.strip()}")

    # 2. 通过 OSTree 原生 contenturl 配置应用本体大包镜像加速
    ostree_res = subprocess.run(
        ["ostree", "config", "--repo=/var/lib/flatpak/repo", "set",
         'remote "flathub".contenturl', MIRROR_CONTENT_URL],
        capture_output=True, text=True
    )
    if ostree_res.returncode == 0:
        log(f"flathub 内容加速源已配置: contenturl -> {MIRROR_CONTENT_URL}")
    else:
        log(f"配置内容加速源失败: {ostree_res.stderr.strip()}")

    # 3. 自动禁用 fedora 冲突源
    subprocess.run([FLATPAK, "remote-modify", "--system", "--disable", "fedora"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log("flathub 官方元数据 + 镜像大包分流架构已就绪")


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    dry_run = "--dry-run" in argv or "-n" in argv
    if os.geteuid() != 0 and not dry_run:
        log("非 root，自动进入 dry-run")
        dry_run = True

    log(f"==> 探测 {DOMAIN} 候选节点（动态 DoH + 本地池，3 次采样 / 6s）")
    ip = pick_node()
    if ip:
        log(f"==> 选中 {ip}")
    else:
        log("==> 所有候选都不稳定，清理 hosts 中的旧记录（回退原生解析）")

    update_hosts(ip, dry_run)
    configure_flatpak(dry_run)
    log("==> 完成")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
