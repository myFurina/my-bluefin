#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/var/lib/my-bluefin"
STATE_FILE="${STATE_DIR}/grub-sync-state"

mkdir -p "${STATE_DIR}"

# 1. 动态自适应探测宿主机是否存在 Windows 引导
has_windows=false

# 1.1 检查 UEFI NVRAM 引导记录
if command -v efibootmgr >/dev/null 2>&1; then
    if efibootmgr 2>/dev/null | grep -qi "Windows Boot Manager"; then
        has_windows=true
    fi
fi

# 1.2 检查 EFI 分区磁盘文件
if [ "${has_windows}" = "false" ]; then
    for efi_candidate in \
        "/boot/efi/EFI/Microsoft/Boot/bootmgfw.efi" \
        "/boot/efi/EFI/Microsoft/bootmgfw.efi" \
        "/boot/EFI/Microsoft/Boot/bootmgfw.efi"; do
        if [ -f "${efi_candidate}" ]; then
            has_windows=true
            break
        fi
    done
fi

TARGET_DIRS=("/boot/grub2" "/boot/efi/EFI/fedora")

if [ "${has_windows}" = "true" ]; then
    echo "==> [my-bluefin] 检测到 Windows 引导项，正在配置双系统 GRUB 菜单..."
    CFG_CONTENT="# Generated by my-bluefin for dual-boot
timeout=10
menuentry \"Windows Boot Manager\" {
    insmod part_gpt
    insmod fat
    search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
"
    for tdir in "${TARGET_DIRS[@]}"; do
        if [ -d "${tdir}" ]; then
            target="${tdir}/user.cfg"
            if [ ! -f "${target}" ] || ! grep -q "Windows Boot Manager" "${target}" 2>/dev/null; then
                printf "%s" "${CFG_CONTENT}" > "${target}"
                chmod 600 "${target}"
                echo "==> [my-bluefin] 已同步 Windows 引导至 ${target}"
            fi
        fi
    done
    echo "windows-present" > "${STATE_FILE}"
else
    echo "==> [my-bluefin] 未检测到 Windows 系统，无需生成 Windows 引导项（保持单系统快速启动）。"
    # 若先前由本脚本生成过 Windows 引导项，则安全清理，避免纯 Linux 机器残留无效项与超时倒计时
    for tdir in "${TARGET_DIRS[@]}"; do
        target="${tdir}/user.cfg"
        if [ -f "${target}" ] && grep -q "Windows Boot Manager" "${target}" 2>/dev/null; then
            if grep -q "Generated by my-bluefin" "${target}" 2>/dev/null; then
                echo "==> [my-bluefin] 清理旧的双系统引导项: ${target}"
                rm -f "${target}"
            fi
        fi
    done
    echo "windows-absent" > "${STATE_FILE}"
fi
