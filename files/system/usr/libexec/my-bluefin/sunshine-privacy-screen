#!/usr/bin/env bash
# ==============================================================================
# Sunshine 物理屏幕防窥控制中心 (Sunshine Privacy Screen Controller)
#
# 功能特性：
# 1. 物理背光断电级熄屏 (brightness=0 & bl_power=4)，不破坏 GPU 渲染与 KMS 抓屏
# 2. 串流防窥期间自动屏蔽 GNOME 亮度快捷键 (Fn+亮度加/减) 与内核 ACPI 亮度切换，杜绝闪屏
# 3. 智能记忆与精准还原关屏前的原始亮度、快捷键与节能策略，断开或退出时无感复原
# 4. 零子进程开销 (Bash 内置 read) 背光守护，运行时锁存于 XDG_RUNTIME_DIR
# ==============================================================================
set -u

# 确保在 systemd ExecStopPost 或 Sunshine 子进程中调用时能正常连接用户 D-Bus (供 gsettings 与 notify-send 使用)
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "/run/user/$(id -u)/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/sunshine"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/sunshine"
STATE_FILE="${STATE_DIR}/saved_brightness"
AMBIENT_STATE_FILE="${STATE_DIR}/saved_ambient_enabled"
INHIBIT_PID_FILE="${RUNTIME_DIR}/inhibit.pid"
GUARDIAN_PID_FILE="${RUNTIME_DIR}/guardian.pid"
KEYS_LOCK_FILE="${RUNTIME_DIR}/keys.locked"

BRIGHTNESS_KEYS=(
    "screen-brightness-up"
    "screen-brightness-down"
    "screen-brightness-up-monitor"
    "screen-brightness-down-monitor"
    "screen-brightness-cycle"
    "screen-brightness-cycle-monitor"
)

stop_pid_file() {
    local pid_file="$1"
    if [ -f "$pid_file" ]; then
        local pid=""
        read -r pid < "$pid_file" 2>/dev/null || true
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$pid_file"
    fi
}

lock_brightness_keys() {
    mkdir -p "$RUNTIME_DIR" "$STATE_DIR"
    # 1. 临时屏蔽 GNOME Shell 屏幕亮度调节快捷键（彻底拦截 Fn+亮度加/减 触发亮屏闪烁）
    if command -v gsettings >/dev/null 2>&1; then
        for key in "${BRIGHTNESS_KEYS[@]}"; do
            gsettings set org.gnome.shell.keybindings "$key" "[]" 2>/dev/null || true
        done
        # 记忆用户原有的环境光自适应配置并临时关闭（idle-dim 已由 systemd-inhibit 阻断，无需改动）
        if [ ! -f "$AMBIENT_STATE_FILE" ]; then
            local orig_ambient=""
            orig_ambient=$(gsettings get org.gnome.settings-daemon.plugins.power ambient-enabled 2>/dev/null || true)
            if [ "$orig_ambient" = "true" ] || [ "$orig_ambient" = "false" ]; then
                echo "$orig_ambient" > "$AMBIENT_STATE_FILE"
            fi
        fi
        gsettings set org.gnome.settings-daemon.plugins.power ambient-enabled false 2>/dev/null || true
    fi

    # 2. 若内核 ACPI video 驱动暴露了硬件按键开关，同步关闭内核态亮度直调
    if [ -w "/sys/module/video/parameters/brightness_switch_enabled" ]; then
        echo N > /sys/module/video/parameters/brightness_switch_enabled 2>/dev/null || true
    fi

    touch "$KEYS_LOCK_FILE"
}

unlock_brightness_keys() {
    if command -v gsettings >/dev/null 2>&1; then
        for key in "${BRIGHTNESS_KEYS[@]}"; do
            gsettings reset org.gnome.shell.keybindings "$key" 2>/dev/null || true
        done
        # 精准还原用户原有的环境光自适应偏好，绝不覆盖用户个性化设置
        if [ -f "$AMBIENT_STATE_FILE" ]; then
            local saved_ambient=""
            read -r saved_ambient < "$AMBIENT_STATE_FILE" 2>/dev/null || true
            if [ "$saved_ambient" = "true" ] || [ "$saved_ambient" = "false" ]; then
                gsettings set org.gnome.settings-daemon.plugins.power ambient-enabled "$saved_ambient" 2>/dev/null || true
            fi
            rm -f "$AMBIENT_STATE_FILE"
        fi
    fi

    if [ -w "/sys/module/video/parameters/brightness_switch_enabled" ]; then
        echo Y > /sys/module/video/parameters/brightness_switch_enabled 2>/dev/null || true
    fi

    rm -f "$KEYS_LOCK_FILE"
}

start_idle_inhibitor() {
    stop_idle_inhibitor
    mkdir -p "$RUNTIME_DIR"
    if command -v systemd-inhibit >/dev/null 2>&1; then
        systemd-inhibit --what=idle:sleep --who="Sunshine" --why="Streaming in privacy mode" --mode=block sleep infinity >/dev/null 2>&1 &
        echo $! > "$INHIBIT_PID_FILE"
    fi
}

stop_idle_inhibitor() {
    stop_pid_file "$INHIBIT_PID_FILE"
}

start_brightness_guardian() {
    stop_brightness_guardian
    mkdir -p "$RUNTIME_DIR"
    # 启动后台守护循环（使用 Bash 内置 read 零 fork 开销，每 200ms 兜底锁定背光与供电为关断状态）
    (
        while true; do
            cur_b=0
            cur_p=0
            read -r cur_b < "${BACKLIGHT_DIR}/brightness" 2>/dev/null || cur_b=0
            read -r cur_p < "${BACKLIGHT_DIR}/bl_power" 2>/dev/null || cur_p=0
            if [ "${cur_b:-0}" -ne 0 ]; then
                echo 0 > "${BACKLIGHT_DIR}/brightness" 2>/dev/null || true
            fi
            if [ "${cur_p:-0}" -ne 4 ]; then
                echo 4 > "${BACKLIGHT_DIR}/bl_power" 2>/dev/null || true
            fi
            sleep 0.2
        done
    ) &
    echo $! > "$GUARDIAN_PID_FILE"
}

stop_brightness_guardian() {
    stop_pid_file "$GUARDIAN_PID_FILE"
}

notify_screen() {
    local title="$1"
    local message="$2"
    local urgency="${3:-normal}"
    local icon="${4:-display-symbolic}"
    echo "[$title] $message"
    if command -v notify-send >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-${DISPLAY:-}}" ]; then
        notify-send -u "$urgency" -i "$icon" "$title" "$message" 2>/dev/null || true
    fi
}

is_sunshine_running() {
    local svc="app-dev.lizardbyte.app.Sunshine.service"
    if systemctl --user list-unit-files sunshine.service &>/dev/null; then
        svc="sunshine.service"
    fi
    if systemctl --user is-active --quiet "$svc" 2>/dev/null; then
        return 0
    fi
    if pgrep -u "$UID" -x "sunshine" >/dev/null 2>&1 || pgrep -x "sunshine" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

is_stream_active() {
    # 1. 若当前环境携带 Sunshine 串流环境变量，说明由 Moonlight 连接事件 (prep-cmd) 直接触发
    if [ -n "${SUNSHINE_CLIENT_NAME:-}" ] || [ -n "${SUNSHINE_CLIENT_ID:-}" ] || [ -n "${SUNSHINE_APP_ID:-}" ]; then
        return 0
    fi

    # 2. 检查 Sunshine 基础服务是否处于运行状态
    if ! is_sunshine_running; then
        return 1
    fi

    # 3. 检查当前会话日志中最新的连接事件，确认是否有活跃的手机/客户端串流会话
    local log_file="${STATE_DIR}/sunshine.log"
    if [ -f "$log_file" ]; then
        local last_event=""
        last_event=$(grep -E "(CLIENT CONNECTED|CLIENT DISCONNECTED)" "$log_file" 2>/dev/null | tail -n 1)
        if [[ "$last_event" == *"CLIENT CONNECTED"* ]]; then
            return 0
        fi
    fi

    return 1
}

lock_desktop_session() {
    # 1. 优先向 GNOME ScreenSaver 发送同步 D-Bus 锁屏调用（跨 systemd user service 最可靠）
    if command -v dbus-send >/dev/null 2>&1; then
        dbus-send --session --dest=org.gnome.ScreenSaver --type=method_call \
            /org/gnome/ScreenSaver org.gnome.ScreenSaver.Lock 2>/dev/null || true
    fi
    # 2. 兜底使用 systemd loginctl lock-sessions（避免 user service 无 XDG_SESSION_ID 报错）
    if command -v loginctl >/dev/null 2>&1; then
        loginctl lock-sessions 2>/dev/null || true
    fi
}

action="${1:-toggle}"
force_flag="false"
lock_mode="auto"
for arg in "${@:2}"; do
    case "$arg" in
        "--force"|"-f") force_flag="true" ;;
        "--no-lock") lock_mode="never" ;;
        "--lock") lock_mode="always" ;;
    esac
done

# 动态探测活跃的背光控制设备
BACKLIGHT_DIR=""
if [ -d "/sys/class/backlight/nvidia_wmi_ec_backlight" ]; then
    BACKLIGHT_DIR="/sys/class/backlight/nvidia_wmi_ec_backlight"
else
    for dev in /sys/class/backlight/*; do
        if [ -d "$dev" ]; then
            BACKLIGHT_DIR="$dev"
            break
        fi
    done
fi

if [ -z "$BACKLIGHT_DIR" ] || [ ! -d "$BACKLIGHT_DIR" ]; then
    stop_brightness_guardian
    stop_idle_inhibitor
    [ -f "$KEYS_LOCK_FILE" ] && unlock_brightness_keys
    rm -f "$STATE_FILE" "$AMBIENT_STATE_FILE"
    if [ "$action" != "on" ] && [ "$action" != "restore" ]; then
        echo "⚠️ 未在系统上找到可用的背光控制设备 (/sys/class/backlight)" >&2
        notify_screen "Sunshine 防窥错误" "未在系统上找到可用的背光控制设备 (/sys/class/backlight)"
        exit 1
    fi
    if [ "$lock_mode" = "always" ]; then
        lock_desktop_session
    fi
    exit 0
fi

get_max_brightness() {
    local val=800
    read -r val < "${BACKLIGHT_DIR}/max_brightness" 2>/dev/null || val=800
    echo "${val:-800}"
}

get_current_brightness() {
    local val=0
    read -r val < "${BACKLIGHT_DIR}/brightness" 2>/dev/null || val=0
    echo "${val:-0}"
}

get_bl_power() {
    local val=0
    read -r val < "${BACKLIGHT_DIR}/bl_power" 2>/dev/null || val=0
    echo "${val:-0}"
}

turn_off_screen() {
    local force="${1:-false}"
    # 安全门禁：只有在手机处于连接串流状态时才允许熄屏，防止误触黑屏锁死
    if [ "$force" != "true" ] && ! is_stream_active; then
        notify_screen "Sunshine 防窥提示" "⚠️ 当前未处于手机连接串流状态，已阻止熄屏以防止误触黑屏锁死。" "critical" "dialog-warning"
        return 1
    fi

    local cur_b
    cur_b=$(get_current_brightness)

    if [ ! -w "${BACKLIGHT_DIR}/brightness" ]; then
        notify_screen "Sunshine 防窥错误" "背光节点缺少写权限，请确认 udev 规则已生效"
        echo "❌ 权限不足: 无法写入 ${BACKLIGHT_DIR}/brightness" >&2
        return 1
    fi

    # 仅在当前亮度大于 0 时记录，避免重复熄屏覆盖掉真实初始亮度
    mkdir -p "$STATE_DIR"
    if [ "$cur_b" -gt 0 ]; then
        echo "$cur_b" > "$STATE_FILE"
    fi

    # 1. 屏蔽 GNOME 亮度调节组合键 (Fn+亮度加/减) 与自动调光，从源头杜绝按键闪屏
    lock_brightness_keys

    # 2. 切断物理背光与亮度
    echo 4 > "${BACKLIGHT_DIR}/bl_power" 2>/dev/null || true
    echo 0 > "${BACKLIGHT_DIR}/brightness" 2>/dev/null || true

    # 3. 抑制 GNOME 自动熄屏与系统休眠，保障串流满血不掉线
    start_idle_inhibitor

    # 4. 启动背光兜底守护进程（防御插拔电源等底层事件点亮屏幕）
    start_brightness_guardian

    notify_screen "Sunshine 防窥模式" "电脑物理屏幕已熄灭（已屏蔽亮度快捷键，黑屏防窥生效）"
}

turn_on_screen() {
    # lock_mode 取值:
    # - "auto"   (默认): 仅当确实处于防窥熄屏状态恢复时才锁屏；若屏幕本就正常亮着则静默无操作返回（保护 ExecStopPost 不误锁本地桌面）
    # - "always" (--lock): 串流结束 (apps.json undo) 显式调用，无论此前是否熄屏均锁定桌面
    # - "never"  (--no-lock): 串流途中手动 toggle 恢复亮屏，只开背光不锁屏
    local lock_mode="${1:-auto}"
    local cur_b cur_p had_lock=false
    cur_b=$(get_current_brightness)
    cur_p=$(get_bl_power)

    if [ -f "$GUARDIAN_PID_FILE" ] || [ -f "$INHIBIT_PID_FILE" ] || [ -f "$KEYS_LOCK_FILE" ]; then
        had_lock=true
    fi

    # 先终止背光守护、释放空闲抑制锁并恢复亮度快捷键
    stop_brightness_guardian
    stop_idle_inhibitor
    if [ "$had_lock" = true ]; then
        unlock_brightness_keys
    fi

    # 若当前屏幕已处于点亮状态（供电正常且亮度>0）且此前无防窥锁：
    # - 默认 (auto, 如 ExecStopPost / stop / restart 调用) 直接静默返回，绝不误锁本地正在使用的桌面！
    # - 仅当 apps.json undo 显式传入 --lock (always) 时，才在退出正常亮屏串流后执行锁屏。
    if [ "$cur_b" -gt 0 ] && [ "$cur_p" -eq 0 ] && [ "$had_lock" = false ]; then
        rm -f "$STATE_FILE" "$AMBIENT_STATE_FILE"
        if [ "$lock_mode" = "always" ]; then
            lock_desktop_session
        fi
        return 0
    fi

    # 确保即使在异常重启丢失 keys.locked 的黑屏急救场景下，也强制重置还原一次亮度快捷键
    if [ "$had_lock" = false ]; then
        unlock_brightness_keys
    fi

    if [ ! -w "${BACKLIGHT_DIR}/brightness" ]; then
        notify_screen "Sunshine 防窥错误" "背光节点缺少写权限，请确认 udev 规则已生效"
        echo "❌ 权限不足: 无法写入 ${BACKLIGHT_DIR}/brightness" >&2
        return 1
    fi

    local max_b target_b=0
    max_b=$(get_max_brightness)

    # 优先恢复进入防窥前记录的实际亮度，并在恢复后清理状态文件
    if [ -f "$STATE_FILE" ]; then
        read -r target_b < "$STATE_FILE" 2>/dev/null || target_b=0
        rm -f "$STATE_FILE" "$AMBIENT_STATE_FILE"
    fi

    # 若未记录或数值无效，默认恢复为当前亮度（若 >0）或 50% 最大亮度
    if [ -z "$target_b" ] || [ "$target_b" -le 0 ]; then
        if [ "$cur_b" -gt 0 ]; then
            target_b="$cur_b"
        else
            target_b=$(( max_b / 2 ))
        fi
    fi

    # 先拉下 GNOME 锁屏帷幕并等待 200ms 渲染就绪，再通电点亮物理背光，杜绝亮屏瞬间闪现桌面内容
    if [ "$lock_mode" = "auto" ] || [ "$lock_mode" = "always" ]; then
        lock_desktop_session
        sleep 0.2
    fi

    echo 0 > "${BACKLIGHT_DIR}/bl_power" 2>/dev/null || true
    echo "$target_b" > "${BACKLIGHT_DIR}/brightness" 2>/dev/null || true

    if [ "$lock_mode" = "auto" ] || [ "$lock_mode" = "always" ]; then
        notify_screen "Sunshine 防窥模式" "电脑物理屏幕已恢复正常亮度并已锁定桌面"
    else
        notify_screen "Sunshine 防窥模式" "电脑物理屏幕已恢复正常亮度与快捷键"
    fi
}

case "$action" in
    "off"|"black")
        turn_off_screen "$force_flag"
        ;;
    "force-off")
        turn_off_screen "true"
        ;;
    "on"|"restore")
        turn_on_screen "$lock_mode"
        ;;
    "toggle")
        cur_b=$(get_current_brightness)
        cur_p=$(get_bl_power)
        if [ "$cur_b" -eq 0 ] || [ "$cur_p" -ne 0 ]; then
            # 串流中手动通过快捷方式切换亮屏，不强制锁屏以免打断当前操作
            turn_on_screen "never"
        else
            turn_off_screen "$force_flag"
        fi
        ;;
    "status")
        cur_b=$(get_current_brightness)
        cur_p=$(get_bl_power)
        max_b=$(get_max_brightness)
        echo "背光设备: ${BACKLIGHT_DIR}"
        echo "当前亮度: ${cur_b} / ${max_b}"
        echo "供电状态: ${cur_p} (0=正常供电, 4=切断供电)"
        if [ "$cur_b" -eq 0 ] || [ "$cur_p" -ne 0 ]; then
            echo "当前显示: 纯黑熄屏中"
        else
            echo "当前显示: 正常亮屏中"
        fi
        ;;
    *)
        echo "用法: $0 {off|force-off|on|toggle|status} [--force|-f] [--lock|--no-lock]"
        exit 1
        ;;
esac
